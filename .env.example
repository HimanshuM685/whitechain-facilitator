# Copy to .env and fill in. Only FACILITATOR_PRIVATE_KEY is required.


# ── Core ────────────────────────────────────────────────────────────────────

# Pays gas on both networks, so there is one address to fund. A hot wallet: it
# signs transactions. It cannot move customer funds — an `exact` payment's
# recipient and amount are fixed in the payer's own signature.
FACILITATOR_PRIVATE_KEY=

# Optional. Postgres (Neon or any) for the public payment log; tables are
# created on first use. Without it, payments still settle and /logs stays empty.
DATABASE_URL=


# ── Networks ────────────────────────────────────────────────────────────────

# Mainnet spends real WBT, so it is off until deliberately enabled. While off,
# /verify still works and /settle returns 503.
MAINNET_ENABLED=false

# Defaults are the public RPCs, rate limited to ~50 req/s per IP.
RPC_URL_TESTNET=https://rpc.testnet.whitechain.io
RPC_URL_MAINNET=https://rpc.whitechain.io


# ── Site ────────────────────────────────────────────────────────────────────

# Public origin. Appears in the docs' copy-paste snippets.
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:3000

# Which network the site opens on: testnet | mainnet
NEXT_PUBLIC_DEFAULT_NETWORK=testnet


# ── Guards (defaults shown) ─────────────────────────────────────────────────

# Dust floor. 10000 = 0.01 at six decimals; below this, gas exceeds the transfer.
MIN_AMOUNT_BASE_UNITS=10000

# Per-settlement ceiling. An EIP-3009 transfer uses 70-90k.
MAX_SETTLE_GAS=300000

# Below this balance, /settle returns 503 instead of broadcasting into failure.
MIN_SIGNER_BALANCE_WBT=0.05

# Requests per 60-second window. In-process counters — single instance only.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_PAYER_PER_MIN=30
RATE_LIMIT_PAYTO_PER_MIN=120
RATE_LIMIT_GLOBAL_PER_MIN=1200


# ── pnpm smoke only ─────────────────────────────────────────────────────────

# An account holding the allowlisted stablecoin and ZERO WBT. The test asserts
# the WBT balance is still zero afterwards — that is the whole proof.
SMOKE_PAYER_PRIVATE_KEY=

# Where the test payment lands. An address you control.
SMOKE_PAY_TO=
