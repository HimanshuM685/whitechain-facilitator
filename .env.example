# --- required ---------------------------------------------------------------

# Pays gas on both networks, so one address to fund. Hot wallet: it signs
# transactions. It can never move customer funds — an `exact` payment's recipient
# and amount are fixed in the payer's own signature.
FACILITATOR_PRIVATE_KEY=0x

# Neon (or any) Postgres. Holds the payment log and backs the daily gas budget.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- networks ---------------------------------------------------------------

# Mainnet spends real WBT, so it is off until you deliberately enable it.
# While off, /verify still works and /settle returns 503.
MAINNET_ENABLED=false

# Public RPCs are rate limited to ~50 req/s per IP. Use dedicated endpoints under load.
RPC_URL_TESTNET=https://rpc.testnet.whitechain.io
RPC_URL_MAINNET=https://rpc.whitechain.io

# --- site -------------------------------------------------------------------

# Your public origin. Shown in the docs' copy-paste snippets and used by the
# demo endpoint to reach its own /verify and /settle.
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# Where the built-in demo endpoint's payments land.
DEMO_MERCHANT_ADDRESS=0x000000000000000000000000000000000000dEaD

# --- guards (defaults shown; all optional) ----------------------------------

# Dust floor: 10000 = 0.01 at six decimals. Below this, gas exceeds the transfer.
MIN_AMOUNT_BASE_UNITS=10000
# An EIP-3009 transfer uses 70-90k; this bounds the pathological case.
MAX_SETTLE_GAS=300000
# Below this balance, /settle returns 503 rather than broadcasting into failure.
MIN_SIGNER_BALANCE_WBT=0.05

# Reset at 00:00 UTC. Database-backed, so correct regardless of replica count.
GAS_BUDGET_DAILY_WBT_TESTNET=1
GAS_BUDGET_DAILY_WBT_MAINNET=0.5
GAS_BUDGET_PER_PAYTO_DAILY_WBT_TESTNET=0.1
GAS_BUDGET_PER_PAYTO_DAILY_WBT_MAINNET=0.05

# Per 60-second window. In-process counters — single instance only.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_PAYER_PER_MIN=30
RATE_LIMIT_PAYTO_PER_MIN=120
RATE_LIMIT_GLOBAL_PER_MIN=1200

# --- smoke test only --------------------------------------------------------

# An account holding the allowlisted stablecoin and ZERO WBT. The test asserts
# the WBT balance is still zero afterwards — that is the whole proof.
SMOKE_PAYER_PRIVATE_KEY=
